rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    match /donations/{donationId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.donorId == request.auth.uid;
      allow update: if signedIn() && resource.data.donorId == request.auth.uid;
      allow delete: if signedIn() && resource.data.donorId == request.auth.uid;
    }

    match /requests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.requesterId == request.auth.uid;
      allow update: if signedIn() && resource.data.requesterId == request.auth.uid;
      allow delete: if false;
    }

    match /pickups/{pickupId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
